DATABASE_URL=postgres://localhost/expenses
SESSION_SECRET=change-this-to-a-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BASE_URL=http://localhost:3000

# Optional
# NODE_ENV=production        # enables secure cookies and verified TLS to the database; requires a real SESSION_SECRET
# TRUST_PROXY=1              # number of reverse proxies in front of the app (needed for secure cookies behind HTTPS proxy)
# DATABASE_SSL_CA=           # custom CA certificate (PEM) for the production database connection
# DATABASE_SSL=false         # disable TLS to the database (only on a trusted private network)
